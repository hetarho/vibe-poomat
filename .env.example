# Copy to .env and adjust. Every key here is validated by @repo/config at boot.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibe_poomat
DATABASE_POOL_MAX=10
JOBS_ENABLED=true

# mail: the console driver logs instead of sending; resend needs a key
MAIL_DRIVER=console
MAIL_FROM=no-reply@vibe-poomat.local
MAIL_FROM_NAME=vibe poomat
# RESEND_API_KEY=

# object storage: MinIO locally, Cloudflare R2 in production
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=vibe-poomat
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/vibe-poomat

# Read by docker-compose only. Change these if something already holds 9000.
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Read by docker-compose only, not by @repo/config.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vibe_poomat
POSTGRES_PORT=5432
