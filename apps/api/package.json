{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "db:generate": "node --env-file=../../.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=../../.env node_modules/drizzle-kit/bin.cjs migrate",
    "dev": "nest start --watch",
    "lint": "depcruise src",
    "start": "node dist/main.js",
    "test": "vitest run && vitest run -c vitest.int.config.ts",
    "test:int": "vitest run -c vitest.int.config.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "@repo/config": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "nestjs-pino": "5.1.0",
    "neverthrow": "8.2.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.2.3",
    "@repo/tsconfig": "workspace:*",
    "@swc/core": "1.16.2",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/uuid": "10.0.0",
    "dependency-cruiser": "18.2.0",
    "drizzle-kit": "0.31.10",
    "typescript": "catalog:",
    "unplugin-swc": "1.5.11",
    "vitest": "catalog:"
  }
}
