  "components": {
    "schemas": {
      "CreateUploadUrlDto": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "avatar",
              "project-cover"
            ]
          },
          "contentType": {
            "type": "string",
            "enum": [
