{
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "The signed-in account's own profile",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Delete the session and clear the cookie",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/{provider}": {
      "get": {
        "operationId": "AuthController_start",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "enum": [
                "github",
                "google"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "The provider's authorize URL"
          }
        },
        "summary": "Start sign-in by redirecting to the provider",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/{provider}/callback": {
      "get": {
        "operationId": "AuthController_callback",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "enum": [
                "github",
                "google"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Where the sign-in started, or the sign-in page with an error code"
          }
        },
        "summary": "Finish sign-in and issue the session cookie",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/uploads": {
      "post": {
        "operationId": "UploadsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadUrlDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "Uploads"
        ]
      }
    }
  },
  "info": {
    "title": "vibe-poomat API",
    "description": "Feedback exchange for vibe-coded side projects",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "CreateUploadUrlDto": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "avatar",
              "project-cover"
            ]
          },
          "contentType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2097152
          }
        },
        "required": [
          "purpose",
          "contentType",
          "sizeBytes"
        ]
      }
    }
  }
}
