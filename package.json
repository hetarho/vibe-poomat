{
  "name": "vibe-poomat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter api run db:generate",
    "db:migrate": "pnpm --filter api run db:migrate",
    "db:up": "docker compose up -d pg",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "turbo": "2.10.12",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.8.1"
  },
  "lint-staged": {
    "*": [
      "biome check --staged --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  }
}
