  "info": {
    "title": "vibe-poomat API",
    "description": "Feedback exchange for vibe-coded side projects",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "bio": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "link": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "avatarKey": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ChangeHandleDto": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "required": [
          "handle"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "liveUrl": {
            "type": "string",
            "format": "uri"
          },
          "pitch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SaaS",
                "Tool",
                "Game",
                "AI",
                "Social",
                "Productivity",
                "Other"
              ]
            }
          },
          "coverKey": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "title",
          "liveUrl",
          "pitch",
          "tags"
        ]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "liveUrl": {
            "type": "string",
            "format": "uri"
          },
          "pitch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SaaS",
                "Tool",
                "Game",
                "AI",
                "Social",
                "Productivity",
                "Other"
              ]
            }
          },
          "coverKey": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "OpenMissionDto": {
        "type": "object",
        "properties": {
          "taskText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "questions": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "slots": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "taskText",
          "slots"
        ]
      },
      "SubmitFeedbackDto": {
        "type": "object",
        "properties": {
          "firstImpression": {
            "type": "string",
            "minLength": 20,
            "maxLength": 4000
          },
          "stuckAt": {
            "type": "string",
            "minLength": 20,
            "maxLength": 4000
          },
          "wouldPay": {
            "type": "boolean"
          },
          "wouldPayReason": {
            "type": "string",
            "minLength": 20,
            "maxLength": 4000
          },
          "suggestion": {
            "type": "string",
            "minLength": 20,
            "maxLength": 4000
          },
          "answers": {
            "default": [],
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 20,
              "maxLength": 4000
            }
          }
        },
        "required": [
          "firstImpression",
          "stuckAt",
          "wouldPay",
          "wouldPayReason",
          "suggestion"
        ]
      },
      "CreateUploadUrlDto": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "avatar",
              "project-cover"
            ]
          },
          "contentType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2097152
          }
        },
        "required": [
          "purpose",
          "contentType",
          "sizeBytes"
        ]
      }
    }
  }
}
