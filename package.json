{
  "name": "vibe-poomat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api:contract": "pnpm openapi:generate && pnpm client:generate",
    "api:contract:check": "pnpm api:contract && git diff --exit-code -- packages/api-client/openapi.json packages/api-client/src/schema.d.ts",
    "client:generate": "pnpm --filter @repo/api-client run generate",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter api run db:generate",
    "db:migrate": "pnpm --filter api run db:migrate",
    "db:up": "docker compose up -d pg",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "lint": "biome check . && node scripts/lint-workflows.mjs",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "openapi:generate": "pnpm --filter api run openapi:generate",
    "prepare": "husky",
    "test": "vitest run",
    "test:docker": "bash scripts/docker-smoke.sh",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "actionlint": "2.0.6",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "turbo": "2.10.12",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.8.1"
  },
  "lint-staged": {
    "*": [
      "biome check --staged --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  }
}
